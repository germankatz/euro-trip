# Copy to `.env` and fill in real values.
# For local dev WITHOUT Docker, change the DATABASE_URL host from `db` to `localhost`.

# Postgres connection string used by Prisma (host `db` matches the compose service name).
DATABASE_URL=postgresql://postgres:postgres@db:5432/eurotrip?schema=public

# Credentials consumed by the `db` service in docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eurotrip

# Auth.js v5 (NextAuth). Generate with: `openssl rand -base64 32`
NEXTAUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
# Public URL the app is reachable at (used for callbacks).
NEXTAUTH_URL=http://localhost:3000

# Initial seed user / trip created by the seed script.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=changeme
SEED_TRIP_NAME=Mi viaje

# Where user-uploaded images are written. Mounted as a named volume in compose.
UPLOAD_DIR=/data/uploads

# Mapbox GL JS token (público, expuesto al cliente).
# Conseguilo en https://account.mapbox.com/access-tokens/ — el tier gratis
# cubre 50k loads/mes, suficiente para este proyecto.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...
