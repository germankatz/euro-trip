# Dependencies (reinstalled inside the image)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build output (rebuilt inside the image)
.next
out
build

# Generated Prisma client (regenerated by `prisma generate` in the builder)
src/generated

# Git / VCS
.git
.gitignore
.gitattributes

# Local env files - never bake secrets into the image.
# `docker compose` reads .env from the host at runtime.
.env
.env.*
!.env.example

# Editor / OS
.vscode
.idea
.DS_Store
*.swp

# Docs (not needed at runtime)
README.md
*.md

# Docker meta (avoid recursive copy)
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# CI / misc
.github
coverage
*.tsbuildinfo
.vercel
